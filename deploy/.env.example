# 复制本文件为 .env 后再填写。.env 已被 .gitignore 排除，切勿提交或随镜像打包。
# 生成 secret：openssl rand -base64 32
# 生成强密码：openssl rand -base64 24

HOMEPAGE_AUTH_PASSWORD=请替换为自己的强密码
NEXTAUTH_SECRET=请替换为openssl_rand_base64_32生成的至少32位随机值
NEXTAUTH_URL=https://你的域名或http://群晖IP:3000

# 实际访问时会用到的全部 host（含端口），逗号分隔。
# NEXTAUTH_URL 里的 host 会被自动信任，这里主要补内网 IP / 其它域名。
HOMEPAGE_ALLOWED_HOSTS=你的域名,192.168.1.100:3000

# 可选：追加匿名可读的只读端点（默认已放行导航页所需端点）
HOMEPAGE_PUBLIC_READ_PATHS=
