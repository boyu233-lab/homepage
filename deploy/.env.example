# 复制本文件为 .env 后再填写。.env 已被 .gitignore 排除，切勿提交或随镜像打包。
# 生成 secret：openssl rand -base64 32
# 生成强密码：openssl rand -base64 24

HOMEPAGE_AUTH_PASSWORD=请替换为自己的强密码
NEXTAUTH_SECRET=请替换为openssl_rand_base64_32生成的至少32位随机值
# 浏览器地址栏里的完整对外地址（含协议 / 域名 / 端口，不带路径）。
# 注意：它同时是登录后的回调基址，写成内网 IP 会导致外网登录后跳回局域网。
NEXTAUTH_URL=https://你的域名

# 实际访问时会用到的全部 host（含端口），逗号分隔，不带 http:// 与路径。
# NEXTAUTH_URL 里的 host 会被自动信任，这里主要补内网 IP / 其它域名 / 反代改写后的 Host。
# 外网走 https 反代时，反代还需透传 X-Forwarded-Proto=https 与 X-Forwarded-Host。
HOMEPAGE_ALLOWED_HOSTS=你的域名,你的域名:443,192.168.1.100:3000

# 可选：追加匿名可读的只读端点（默认已放行导航页所需端点）
HOMEPAGE_PUBLIC_READ_PATHS=
